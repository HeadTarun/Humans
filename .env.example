# ─── ASHIELDER Backend Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.

# ─── Database ──────────────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres

# ─── Authentication ────────────────────────────────────────────────────
# API Key for service-to-service auth. Must match VITE_API_KEY in frontend.
SECRET_KEY=dev_secret_key

# ─── Security & Network ────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://api.ashielder.com

# ─── AI & Threat Intelligence APIs ─────────────────────────────────────
# Groq (LLM Reasoning)
GROQ_API_KEY=your_groq_api_key

# VirusTotal
VIRUSTOTAL_API_KEY=your_virustotal_key

# AbuseIPDB
ABUSEIPDB_API_KEY=your_abuseipdb_key

# IPinfo (Geolocation)
IPINFO_TOKEN=your_ipinfo_token

# ─── Application Tuning ────────────────────────────────────────────────
INVESTIGATION_MAX_LATENCY_MS=4000
INVESTIGATION_MAX_TOOL_CALLS=8
INVESTIGATION_MAX_EXTERNAL_CALLS=4
GEOLOCATION_EXTERNAL_ENABLED=true
